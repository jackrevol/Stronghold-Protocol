# Set these in Vercel Project Settings > Environment Variables, then redeploy.
# Local: node --env-file=.env server/index.js (npm start does not load .env automatically).
# public: anyone can create; owner: requires owner key; disabled: no new rooms.
SP_ROOM_CREATION=public
# Required only in owner mode. Generate with: openssl rand -hex 32
# SP_OWNER_KEY=
# Optional Vercel build-time art/audio download (~270 MB); 0 uses existing assets/placeholders.
SP_FETCH_ASSETS=0
